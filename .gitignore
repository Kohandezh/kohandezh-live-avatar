.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/
node_modules/
.DS_Store

# Runtime media written by the orchestrator and the Egress worker.
media/audio/*
!media/audio/.gitkeep
media/video/*
!media/video/.gitkeep
media/metadata/*
!media/metadata/.gitkeep
infra/postgres/data/
*.log

# Frontend build output
apps/frontend/dist/
apps/frontend/dev-dist/
apps/frontend/.env.local
apps/frontend/.env.*.local

# Agent worktrees created by the desktop app
.claude/worktrees/

# Playwright output
apps/frontend/test-results/
apps/frontend/playwright-report/

# HeroUI docs downloaded by `npx heroui-cli agents-md`
.heroui-docs/
