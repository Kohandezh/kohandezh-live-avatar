{
  "name": "@app/frontend",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:mobile": "APP_TARGET=mobile vite",
    "dev:web": "APP_TARGET=web vite",
    "dev:admin": "APP_TARGET=admin vite",
    "dev:widget": "APP_TARGET=widget vite",
    "build": "tsc -b && pnpm run build:mobile && pnpm run build:web && pnpm run build:admin && pnpm run build:widget",
    "build:mobile": "APP_TARGET=mobile vite build",
    "build:web": "APP_TARGET=web vite build",
    "build:admin": "APP_TARGET=admin vite build",
    "build:widget": "APP_TARGET=widget vite build",
    "preview:mobile": "APP_TARGET=mobile vite preview",
    "preview:web": "APP_TARGET=web vite preview",
    "preview:admin": "APP_TARGET=admin vite preview",
    "preview:widget": "APP_TARGET=widget vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@heroui/react": "^3.2.5",
    "@heroui/styles": "^3.2.5",
