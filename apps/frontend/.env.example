# Base URL of the backend API. Used by src/shared/api/client.ts.
VITE_API_BASE_URL=https://api.example.com

# development | staging | production
VITE_APP_ENV=development

# "true" answers API calls with local mock data (src/data/mock).
# Useful when no backend is running. Never enable this in production.
VITE_API_MOCK=false
