# Copy to .env. Real provider tests are disabled unless explicitly enabled.
APP_ENV=development
LOG_LEVEL=INFO
REAL_PROVIDER_TESTS=false
API_PORT=8000
FRONTEND_PORT=8088

# ElevenLabs: use a Persian-capable model/voice available to your account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3_conversational
ELEVENLABS_LANGUAGE_CODE=fa
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_WS_URL=wss://api.elevenlabs.io
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_TIMEOUT_SECONDS=30
ELEVENLABS_STABILITY=0.50
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEED=1.0

# LiveAvatar LITE. Sandbox consumes no credits and uses the documented sandbox avatar.
# Transport decides who owns the LiveKit room the session runs in.
#   managed - LiveAvatar provisions the room and returns its URL plus a browser token. Nothing of
#             ours has to be reachable from the internet, so this works on a laptop. Recording is
#             unavailable, because our Egress worker cannot join a room we do not own.
#   byo     - we create the room in our own LiveKit and hand LiveAvatar a publisher token. Needs a
#             public wss:// endpoint and reachable media ports. This is the only mode that records.
LIVEAVATAR_TRANSPORT=managed
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=dd73ea75-1218-4ef3-92ce-606d5f7fbc0a
LIVEAVATAR_BASE_URL=https://api.liveavatar.com
LIVEAVATAR_SANDBOX=true
LIVEAVATAR_MAX_SESSION_SECONDS=60
LIVEAVATAR_CONNECT_TIMEOUT_SECONDS=30

# Assistant (LiveAvatar FULL mode). LiveAvatar runs the whole conversation in their cloud and the
# browser only publishes the microphone, so nothing of ours has to be reachable.
# The context id is the persona the avatar answers with. FULL mode without it is "restricted" and
# the avatar stays silent, so the assistant refuses to start a session when it is empty.
LIVEAVATAR_CONTEXT_ID=988c3b64-3470-4c7f-b85e-290f472d77aa
# Optional. Leave empty to use the voice of the context.
LIVEAVATAR_ASSISTANT_VOICE_ID=
LIVEAVATAR_ASSISTANT_LANGUAGE=fa
# Comma separated languages the assistant may actually start a session in. Verified against the
# real provider on 2026-09-11: the token mint step accepts "fa", but the session start step
# rejects it ("Language not supported"), because the STT/TTS providers behind FULL mode do not
# support Persian yet. Add "fa" here once a supporting provider is available.
LIVEAVATAR_ASSISTANT_LANGUAGES=en
# The production (custom) avatar. Sandbox cannot use it, so it is ignored while sandbox is on.
LIVEAVATAR_ASSISTANT_AVATAR_ID=fa12beb7-dbe6-483e-a129-4939e8fc1e4a
# Sandbox sessions end after about 60 seconds. The backend clamps this to 60 while sandbox is on.
LIVEAVATAR_ASSISTANT_MAX_SESSION_SECONDS=60

# Website widget. The key ships inside the widget script, so it is public, not a secret. What
# protects the account is the origin allowlist plus the hourly limit per visitor address.
# Leave the key empty to keep the widget turned off. "*" as an origin works in development only.
ASSISTANT_EMBED_KEY=
ASSISTANT_EMBED_ALLOWED_ORIGINS=
ASSISTANT_RATE_LIMIT_PER_HOUR=20

# Phone login with a one-time code.
# "console" writes the code to the log. It is only written in development; in any other
# environment nothing is logged and you need a real SMS sender before login works.
# "asanak" sends the code by SMS through Asanak. Use it in staging and production.
OTP_DELIVERY=console
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=120

# Asanak SMS. Only read when OTP_DELIVERY=asanak, and then the username and the password are
# required: the backend refuses to start without them.
# The web service user from the Asanak panel. This is not the panel login.
ASANAK_USERNAME=
# The web service password. Asanak expires it, so put a rotation reminder in the calendar.
ASANAK_PASSWORD=
# The sender line the template is registered on. Asanak picks the line from the template, so it
# is not sent in the request; it is here so the operator knows which line the account uses.
ASANAK_SOURCE=9821700021
# The approved OTP template in the panel.
ASANAK_TEMPLATE_ID=1654
# The template variable that holds the code. Change it if the template uses another name.
ASANAK_TEMPLATE_CODE_PARAMETER=code
ASANAK_BASE_URL=https://sms.asanak.ir/webservice/v2rest
ASANAK_TIMEOUT_SECONDS=10
# Comma separated phones that get the admin role at login. 09... and +98... both work.
ADMIN_PHONES=
# How long a login lasts, for the kd_session cookie and for the native bearer token.
SESSION_TTL_DAYS=30

# Comma separated browser origins allowed to call the API with credentials. The mobile, web,
# admin and widget dev servers plus the Capacitor origins are listed for local development.
# The origins in ASSISTANT_EMBED_ALLOWED_ORIGINS are added to this list automatically.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:8088,capacitor://localhost,http://localhost

# Internal LiveKit URL is used by server SDK and Egress inside Compose.
LIVEKIT_URL=http://livekit:7880
LIVEKIT_WS_URL=ws://livekit:7880
LIVEKIT_EGRESS_HEALTH_URL=http://livekit-egress:8080
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.5
LIVEKIT_EGRESS_IMAGE=livekit/egress:v1.14.1
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
# Browser URL can be ws://localhost:7880 for local-only mocked testing.
PUBLIC_LIVEKIT_URL=ws://localhost:7880
# Real LiveAvatar BYO LiveKit requires a trusted public wss:// URL and reachable media ports.
LIVEKIT_NODE_IP=
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882

POSTGRES_DB=kohandezh_avatar
POSTGRES_USER=kohandezh
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://kohandezh:replace-with-a-long-random-password@postgres:5432/kohandezh_avatar
REDIS_URL=redis://redis:6379/0

MEDIA_ROOT=/media
AUDIO_CACHE_DIR=/media/audio
VIDEO_CACHE_DIR=/media/video
METADATA_DIR=/media/metadata
EGRESS_OUTPUT_DIR=/out
