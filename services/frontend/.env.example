# Only VITE_* variables reach the browser bundle. Never put secrets here — the bundle is public.
# The frontend never receives ElevenLabs, LiveAvatar or LiveKit API secrets; it only receives a
# scoped browser token from POST /api/avatar/session.

VITE_APP_NAME=Dr.Kohandezh Live Avatar
# Same-origin prefix served by Nginx (production) or proxied by Vite (development).
# A Capacitor build must use an absolute URL, e.g. https://live.kohandezh.com/api
VITE_API_BASE_URL=/api
VITE_ENV=development
VITE_ENABLE_DEVTOOLS=true

# Development only: where `vite dev` proxies /api (the Compose frontend/Nginx port).
VITE_DEV_PROXY_TARGET=http://localhost:8088
