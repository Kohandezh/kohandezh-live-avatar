{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:mobile": {
      "dependsOn": ["^build:mobile"],
      "outputs": ["dist/mobile/**"]
    },
    "build:web": {
      "dependsOn": ["^build:web"],
      "outputs": ["dist/web/**"]
    },
    "build:admin": {
      "dependsOn": ["^build:admin"],
      "outputs": ["dist/admin/**"]
    },
    "build:widget": {
      "dependsOn": ["^build:widget"],
      "outputs": ["dist/widget/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:e2e": {
      "dependsOn": ["^test:e2e"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:mobile": {
      "cache": false,
      "persistent": true
    },
    "dev:web": {
      "cache": false,
      "persistent": true
    },
    "dev:admin": {
      "cache": false,
      "persistent": true
    },
    "dev:widget": {
      "cache": false,
      "persistent": true
    },
    "preview:mobile": {
      "cache": false,
      "persistent": true
    },
    "preview:web": {
      "cache": false,
      "persistent": true
    },
    "preview:admin": {
      "cache": false,
      "persistent": true
    },
    "preview:widget": {
      "cache": false,
      "persistent": true
    }
  }
}
