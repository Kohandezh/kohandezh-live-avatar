{
  "name": "cross-platform-starter",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm install && docker compose up -d && concurrently -c \"blue,green,magenta,yellow\" -n \"web,mobile,admin,widget\" \"pnpm dev:web\" \"pnpm dev:mobile\" \"pnpm dev:admin\" \"pnpm dev:widget\"",
    "dev:mobile": "turbo run dev:mobile",
    "dev:web": "turbo run dev:web",
    "dev:admin": "turbo run dev:admin",
    "dev:widget": "turbo run dev:widget",
    "build": "turbo run build",
    "build:mobile": "turbo run build:mobile",
    "build:web": "turbo run build:web",
    "build:admin": "turbo run build:admin",
    "build:widget": "turbo run build:widget",
    "preview:mobile": "turbo run preview:mobile",
    "preview:web": "turbo run preview:web",
    "preview:admin": "turbo run preview:admin",
    "preview:widget": "turbo run preview:widget",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "icons": "turbo run icons",
    "cap:sync": "turbo run cap:sync",
    "cap:android": "turbo run cap:android",
    "cap:ios": "turbo run cap:ios",
    "format": "prettier --write ."
  },
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "turbo": "^2.10.12"
  }
}
