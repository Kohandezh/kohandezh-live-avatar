# Copy to .env.development / .env.staging / .env.production (already provided) or .env.local for overrides.
# Only VITE_* variables reach the browser. Never put secrets here — the bundle is public.

VITE_APP_NAME=Starter App
VITE_API_BASE_URL=http://localhost:8787
VITE_ENV=development
# Optional: enable React Query devtools
VITE_ENABLE_DEVTOOLS=true
