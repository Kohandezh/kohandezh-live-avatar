{
  "name": "starter-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform PWA / Capacitor frontend starter. Shared codebase for Web, Android and iOS.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --mode development",
    "dev:mock": "pnpm --dir mock-backend dev",
    "dev:all": "concurrently -n web,mock -c blue,green \"pnpm dev\" \"pnpm dev:mock\"",
    "build": "tsc -b && vite build --mode production",
    "build:staging": "tsc -b && vite build --mode staging",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "cap:sync": "pnpm build && cap sync",
    "cap:android": "pnpm cap:sync && cap open android",
    "cap:ios": "pnpm cap:sync && cap open ios",
    "postinstall": "pnpm --dir mock-backend install --silent || true"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.4.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@tanstack/react-query": "^5.85.0",
    "capacitor-secure-storage-plugin": "^0.11.0",
    "i18next": "^25.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.6.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@eslint/js": "^9.33.0",
    "@tanstack/react-query-devtools": "^5.85.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^3.2.4"
  }
}
