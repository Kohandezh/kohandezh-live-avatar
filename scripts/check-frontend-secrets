#!/usr/bin/env python3
"""Fail if the frontend bundle source or its public env files name a server secret.

Only VITE_* values reach the browser and all of them are public, so a server secret named
anywhere under apps/frontend is a leak waiting to be shipped. Runs with no dependencies, so
CI can call it from the frontend job where the whole repository is checked out.
"""

import sys
from pathlib import Path

FORBIDDEN = (
    "ELEVENLABS_API_KEY",
    "LIVEAVATAR_API_KEY",
    "LIVEKIT_API_SECRET",
    "DATABASE_PASSWORD",
    "POSTGRES_PASSWORD",
)


def frontend_sources(frontend_dir: Path) -> list[Path]:
    src = frontend_dir / "src"
    paths = list(src.rglob("*.ts")) + list(src.rglob("*.tsx"))
    paths += [path for path in frontend_dir.glob(".env*") if path.is_file()]
    return paths


def check(frontend_dir: Path) -> list[str]:
    problems = []
    for path in frontend_sources(frontend_dir):
        content = path.read_text(encoding="utf-8")
        for forbidden in FORBIDDEN:
            if forbidden in content:
                problems.append(f"{path} references {forbidden}")
    return problems


def main() -> int:
    frontend_dir = Path(__file__).resolve().parents[1] / "apps" / "frontend"
    if not frontend_dir.is_dir():
        print(f"frontend directory not found at {frontend_dir}", file=sys.stderr)
        return 1

    sources = frontend_sources(frontend_dir)
    if not sources:
        print(f"no frontend sources found under {frontend_dir}", file=sys.stderr)
        return 1

    problems = check(frontend_dir)
    for problem in problems:
        print(problem, file=sys.stderr)
    if problems:
        return 1

    print(f"checked {len(sources)} frontend files for server secrets: clean")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
